# Copiar a .env y ajustar segun el entorno. El archivo .env real NO se versiona.

# Puerto del servidor HTTP
PORT=8080

# Modo de ejecucion: development | production
# En production se recomienda deshabilitar el playground y la introspection.
APP_ENV=development

# Habilita el playground de GraphQL: true | false
GRAPHQL_PLAYGROUND=true

# Nivel de logging: debug | info | warn | error
LOG_LEVEL=info

# Repositorio a usar: memory | postgres
REPO_DRIVER=memory

# Cadena de conexion, solo necesaria cuando REPO_DRIVER=postgres
# DATABASE_URL=postgres://products:products@localhost:5432/products?sslmode=disable
